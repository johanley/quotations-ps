%!PS

% The body of the book. The cover is a separate PostScript file.
% Example Ghostscript command (see BUILD.BAT):
%  C:\ghostscript\gs10.04.0\bin\gswin64c.exe -dNOSAFER -sDEVICE=pdfwrite -o BOOK.PDF BOOK.PS

(using.ps) run
(base.ps) using
(debug.ps) using
(fonts.ps) using
(strings.ps) using
(text-align.ps) using
(jagged-right.ps) using

% sequential id for the top-level parts of the book (front, quotes, index, ...) ; (this might evolve into a dict)
/SECTION 0 def 

% increment the section number
/end-of-section { /SECTION SECTION 1 add def } bind def

% {} 
% exec the proc to render the section, then increment the section number
/do-section { 
  % showpage ?? not for the first section; maybe use a bool flag to control this
  exec end-of-section 
} bind def

/page-num 0 def 

% . -> int
/num-physical-pages {
  page-num 3 add % since the front matter has no page num
} bind def

% int 
% The implementation of BeginPage
% arg is 0 the first time called; then its the number of times /showpage has been called: 1, 2, ...
% See below : /BeginPage of setpagedevice.
/start-new-page {
  3 sub /page-num defi
  2 dict begin
    [(Starting new page: ) page-num]  any-concat here
    SECTION 1 ge  SECTION 2 le and {
      % show page numbers and title
      % set the work-box; asymmetry in x, to avoid the spine 
      bleed  MARGIN-X  add  SPINE-AVOIDANCE page-num 2 mod 0 eq {neg} if add 
      bleed  MARGIN-Y  add
      translate % to the bottom left of the work-box
      
      (regular) 90 use-font
      /GAP ht 5 pct def
      small-caps-font
      /page-num-str page-num 4 string cvs def
      page-num 2 mod 0 eq {
        % left-hand page
        0 ht moveto 
        0 GAP rmoveto 
        page-num-str show
      } {
        % right-hand page
        wd ht moveto 
        0 GAP rmoveto 
        page-num-str show-right-align
      } ifelse
      wd 50 pct  ht GAP add  moveto 
      SECTION 1 eq {TITLE}{INDEX-TITLE}ifelse str-upper-case show-ctr-x
      (regular) 100 use-font
    } {
      % no page numbers, and the centering is a bit different
      % set the work-box using only the trimmed page, with no margins
      bleed  bleed  translate % to the bottom left of the work-box
    }
    ifelse
    
    0 ht moveto % the top-left of the work-box, as a default currentposition
    %0 0 wd ht rectstroke % to see the work-box
  end  
} bind def

% cx cy str 
% Show text centered horizontally at the currentpoint, using /ashow.
/ashow-ctr-x {
  dup text-dim pop % text dx
  -2 div % text -dx/2
  0 rmoveto % text
  ashow
} bind def

% dict
% The dict has author, title, and body (an array).
% Show a quotation, but first test to see if a new page is needed.
% The policy is that quotations are never split by a page-break.
/show-quotation-on-1-page {
  dup 
  quotation-fits-on-page? not {
    NEW-PAGE
  } if
  true show-quotation
  NEW-LINE % between rendered quotes
  NEW-LINE 
} bind def

% dict
% The dict has author, title, and body (an array).
/quotation-fits-on-page? {
  % save-program-state here IF NEEDED
  %/orig-page-num page-num def % not needed; apparently the nulldevice won't start a new page
  2 dict begin
    % the trick here is to use the NULL DEVICE, with a gsave-grestore.
    % no marks are made on the page using this technique
    gsave 
      nulldevice % this uses the default CTM
      cp-y /y0 defi
      false show-quotation
      cp-y /y1 defi
      y1 y0 sub % dy (corresponding to the author/title line); negative!
    grestore
    cp-y % dy y 
    add 0 ge 
  end  
  % restore-program-state here IF NEEDED
  %/page-num orig-page-num def
} bind def

% dict bool
% The dict has author-last, author-first, title, and body.
% The bool controls if the index is to be updated or not.
% The body is an array for prose, and a string (with \n's) for poetry.
% (Defect: a poem is always rendered using a single font.)
/show-quotation {
  [/quote /update-index?] {
    quote {def} forall
    body type /arraytype eq {
      show-body-prose
    } {
      show-body-poetry
    } ifelse
    show-author-title
    update-index? {quote add-to-index pop} if
  } def-tmp
} bind def

% []
% Cycle through an array containing strings and control-code names.
% The control codes can only set the font.
% Set the currentpoint to the start of the next line, to prepare for the author-title line.
/show-body-prose {
  % ragged-right; limit is wd, but with a tolerance of 2em
  % call new-line, but leave new-page to the caller.
  body {
    dup 
    type /nametype eq {
      cvx exec % control code
    } {
      wd 2 em jagged-right-2 pop % discard stats
    } ifelse
  } forall 
  NEW-LINE
} bind def

% Show lines of text having hard-coded line breaks, as in poetry.
% The /body is a single string, with \n-style newlines (such that the whole poem is 1 line of source data).
% No control codes are used in this style, and only the regular font is used.
% Set the currentpoint to the start of the next line, to prepare for the author-title line.
/show-body-poetry {
  % lines of fixed length, and only regular font
  (regular) 100 use-font
  body str-lines {
    show % one line at a time
    NEW-LINE % might cause a new page
  } forall % lines
} bind def

% str
% Return true iff the trimmed string has a length > 0
/is-present? {
  str-trim length 0 gt
} bind def

% from author-last and author-first.
/author-name {
  author-last (ZzzUnknown) eq {
    % special handling for anonymous authors (hacky!); this exists only because I want 
    % them at the END of the quote list
    () % just use an empty string
  } {
    author-first is-present? {
      [author-first SPACE author-last] any-concat
    } {
      author-last
    } ifelse
  } ifelse 
} bind def

% Show the author and/or title.
% Must fit on a single line.
% The author and title can be an empty string, but not both at the same time.
% The caller puts the currentpoint at the start of the line, after the quote body has finished.
% Assumes the author/title data is trimmed of empty spaces.
/show-author-title {
  % measure the width first, in order to find the starting point for /show
  % be careful with the comma in between: three cases: a+comma+space+t, a, t
  /size 90 def
  /authors-name author-name def
  (regular) size use-font
  /width-all 
    DASH str-width 
    small-caps-font
    authors-name str-upper-case str-width add
    (italic) size use-font
    title str-width add 
  def
  authors-name is-present? title is-present? and {
    (regular) size use-font
    /width-all  width-all COMMA-SPACE str-width  add  def
  } if
  wd width-all sub  0  rmoveto % where the text starts
  
  (regular) size use-font
  DASH show
  authors-name is-present? {
    small-caps-font  authors-name str-upper-case show
  } if
  authors-name is-present? title is-present? and {
    (regular) size use-font  COMMA-SPACE show
  } if
  title is-present? {
    (italic) size use-font  title show 
  } if
  % let's not put a new line here yet; 
  % we need to interrogate the y-position at this point, for page breaks
} bind def

% Use the regular font.
/R { (regular) 100 use-font } bind def

% Use the italic font.
/I { (italic) 100 use-font } bind def

/NEW-LINE {
  0  cp-y leading sub   moveto
} bind def

/NEW-PAGE {
  showpage  % start-new-page will also be invoked (see above)
} bind def

% str 
% pass the filename
/process-quotes-file-one-line-at-a-time {
  MAX-QUOTE-LENGTH {show-quotation-on-1-page} process-file-one-line-at-a-time
} bind def

% str buffer-size {proc}
% Pass the file name, buffer size, and how to process the PostScript snippet on each line.
/process-file-one-line-at-a-time {
  [/file-name /buffer-size /do-stuff] {
    file-name (r) file /the-file defi 
    buffer-size string /buffer defi
    { the-file buffer readline exch % bool str
      cvx % the string is scanned and interpreted according to PostScript rules
      exec % to transform the executable string into a dict, and put it on the stack
      do-stuff
      not {exit} if % EOF encountered, exit the loop
    } loop
    % the loop will automatically close the file once end-of-file has been reached.
    % this is just being extra-careful:
    the-file status {
      (CLOSING THE OPEN FILE.) == 
      the-file closefile
    } {
      (OK: THE FILE HAS BEEN CLOSED.) ==
    } ifelse
  } def-tmp
} bind def

% The data structure that holds index information : [dict]
/INDEX 700 array def % initially all nulls; buffer for index entries (dicts); has nulls at the end
/INDEX-TITLE (INDEX) def

% [dict]
/show-index-lines {
  { 
    dup null eq {
      exit
    } if
    show-index-line
  } forall
} bind def

% dict
% The dict contains /author-last, /author-first, /title, and /page.
% Example output:
%   DYLAN, BOB Shelter From The Storm.......56 
/show-index-line {
  7 dict begin
    { def } forall % put the dict entries into currentdict
    /size 90 def
    /authors-name author-name-for-index def
    (regular) size use-font
    small-caps-font
    authors-name is-present? {authors-name SPACE str-concat str-upper-case show} if
    title is-present? {
      (italic) size use-font
      title SPACE str-concat show
    } if 
    (regular) size use-font
    1 ex 0 rmoveto % bit to the right
    /DOT (.) def
    {
      % emit dots, but stop when you near the page-num's x-position 
      cp-x   wd page str-width sub 1 ex sub   ge { exit } if
      2 ex 0 DOT ashow % stretch out the spacing with /ashow
    } loop
    wd  cp-y  moveto % the right side
    page show-right-align
    NEW-LINE
    cp-y 0 le { NEW-PAGE } if
  end
} bind def

% from /author-last and /author-first.
/author-name-for-index {
  author-last (ZzzUnknown) eq {
    % special handling for anonymous authors (hacky!); this exists only because I want 
    % them at the END of the index
    () 
  } {
    author-first is-present? {
      [author-last COMMA-SPACE author-first] any-concat
    } {
      author-last
    } ifelse
  } ifelse 
} bind def

% quote (a dictionary) -> bool
% Return true iff a new entry gets added to the INDEX array as a side effect.
% Replaces the first 'null' item in INDEX with a dict for the index entry (derived from the quote-dict).
/add-to-index {
  [/quote] {
    false % default on stack
    INDEX next-avail-idx {
      /next-avail defi
      /compare-using [/author-last /author-first /title] def
      /add-next? next-avail 0 eq def
      add-next? not {
        /add-next?
          INDEX  next-avail 1 sub  get  % compare the last index entry to the quote
          quote  
          compare-using  same-vals? not
        def
      } if
      add-next? {
        quote << >> copy /next-entry defi
        next-entry /body undef % not wanted for the index
        next-entry /page page-num 4 string cvs put 
        INDEX next-avail next-entry put
      } if
      pop add-next? % left on stack
    } if
  } def-tmp
} bind def

% [] -> int bool
% Return the index of the first null item in the array.
% The boolean is true iff an answer has been found between 0 and (length-1) for the array.
% The int is provided iff the bool is true.
% The backing idea: sometimes an array can be used as a buffer, starting off as all-nulls, 
% and then filled up with stuff. This proc tells you where to insert the next thing.
/next-avail-idx {
  [/a] {
    false % default result: no null item is found in the array (or the array is empty)
    a length 0 gt {
      0  1  a length 1 sub {
        /idx defi
        a idx get null eq {
          idx exch % idx false
          not      % idx true
          exit
        } if
      } for
    } if
  } def-tmp
} bind def

% dict-a dict-b [keys] -> bool
% Return true iff the values corresponding to the given keys are the same for dict-a and dict-b.
% (This assumes the values are simple, non-composite objects.)
/same-vals? {
  [/dict-a /dict-b /keys] {
    true % default result
    keys {
      /key defi
      dict-a key get   dict-b key get   ne {
        not % true -> false
        exit % no need to look further
      } if
    } forall
  } def-tmp
} bind def

% [[xy]]
% The caller will need to set the origin and scale to suitable values, using trial and error.
/draw-star-line {
  1 dict begin
    newpath
    /is-first? true def
    {
      aload pop % x y
      is-first? { moveto } {lineto } ifelse
      /is-first? false def
    } forall % points [x y]
    stroke
  end  
} bind def

% x y stellar-mag
% two circles at the given location
% first in the background color, then in the foreground with a smaller radius
% this will give a pleasing effect when drawing star-points after the star-lines
/draw-star-point {
  newpath
  [/x /y /stellar-mag] {
    /radius stellar-mag 2.5 gt {0.30} {0.45} ifelse  def
    1 setcolor
    x y radius 0 360 arc % to 'erase' star-lines a wee bit around the star
    fill
    0 setcolor
    x y radius 0.7 mul 0 360 arc
    fill
  } def-tmp
} bind def

/inch {72 mul} bind def
/8th-inch {72 mul 8 div} bind def

%%BeginSetup    
   % 'US Trade' is 6" x 9". This is called the 'trim' size.
   %   'trim': the dimensions after trimming off the 'bleed'.
   %   'bleed': margin around all sides that gets cut off (trimmed); 1/8" is typical.
   %   'safety': margin around all sides in which text should not appear. 1/8" is typical.
  /trim-width 6 inch def 
  /trim-height 9 inch def 
  /bleed 1 8th-inch def 
  /page-width  trim-width bleed 2 mul add  def 
  /page-height  trim-height bleed 2 mul add  def 
  /ASPECT-RATIO trim-height trim-width div def % > 1.0 in this project
  /MARGIN-X 7 8th-inch def 
  /MARGIN-Y 6 8th-inch def 
  % wd and ht are for the work-box for the main content (pages with page numbers).
  /wd trim-width MARGIN-X 2 mul sub def   
  /ht trim-height MARGIN-Y 2 mul sub def   
  /SPINE-AVOIDANCE 1.5 8th-inch def
  <<
    /PageSize [page-width  page-height]
    /BeginPage {start-new-page}  
  >> setpagedevice  
  << /NeverEmbed [ ] >> setdistillerparams  % always embed fonts
  true setstrokeadjust  % minimizes off-by-one-pixel line issues

  %C:\Users\Owner\AppData\Local\Microsoft\Windows\Fonts
  /MyRegular /ACaslonPro-Regular windowize
  /MyItalic /ACaslonPro-Italic windowize
  <<  (regular) /MyRegular (italic) /MyItalic >>
  11 % default font size 
  init-my-fonts
  % My initial model was the book "Jerusalem" by Simon Montefiore (Knopf, 2011)
  
  /leading 1.2 11 mul def % this is a common leading, 120% of the type size (InDesign's default)
  /TITLE (Quotations) def
  /AUTHOR (Collected by John O’Hanley) def
  /DATE (1988 - 2025) def
  /SPACE ( ) def
  /DASH (~ ) def
  /COMMA-SPACE (, ) def
  /QUOTES-FILE (quotes-data-1252/quotes_relativity_flat_file_ps.txt) def
  /MAX-QUOTE-LENGTH 5000 def 
%%EndSetup 

/show-front-matter {
  % small title 
  (regular) 100 use-font  
  trim-width 48 pct 
  trim-height 85 pct moveto 
  3 0 TITLE str-upper-case ashow-ctr-x

  % font details, link to github 
  (regular) 100 use-font
  trim-width 50 pct 
  trim-height 15 pct moveto 
  (Adobe Caslon Pro 11 \(leading 13.2\)) show-ctr-x

  (italic) 100 use-font
  trim-width 50 pct 
  trim-height 10 pct moveto 
  (github.com/johanley/quotations-ps) show-ctr-x

  showpage
  % blank page 
  showpage

  % large title and drawing
  (regular) 230 use-font  
  trim-width 46 pct trim-height 85 pct moveto 
  0.3 em 0 TITLE str-upper-case ashow-ctr-x
  
  % a drawing of a constellation
  gsave 
    % put the origin near the center of the drawing
    trim-width 50 pct
    trim-height 50 pct  
    translate 

    % manually tweak the scale  
    4.5 dup scale  
    0.2 setlinewidth

    % draw a well-known constellation, as simple lines and dots  
    % no labels are used here, just the basic shape
    (constellaton-data-1252/orion.ps) run
  grestore

  (regular) 125 use-font  
  trim-width 50 pct trim-height 15 pct moveto 
  AUTHOR show-ctr-x
  trim-width 50 pct trim-height 10 pct moveto 
  DATE show-ctr-x

  showpage
} bind def

/show-main-body { 
  showpage % this really ends the previous section
  QUOTES-FILE process-quotes-file-one-line-at-a-time 
} bind def

/show-index {
  showpage
  INDEX show-index-lines
} bind def

/show-trailing-blank-pages {
  showpage 
  % lulu.com requirement: must end with 2 blank pages
  showpage
  showpage
  % Lulu.com requirement: num-physical-pages to be divisible by 4
  {
    num-physical-pages 4 mod 0 eq {exit} if
    (Adding blank page) ==
    showpage
  } loop
  (Num physical pages: ) ==
  num-physical-pages ==
} bind def

% TOP LEVEL: RENDER THE SECTIONS OF THE BOOK IN SEQUENCE:
{show-front-matter} do-section 
{show-main-body} do-section
{show-index} do-section
{show-trailing-blank-pages} do-section